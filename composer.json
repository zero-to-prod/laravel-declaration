{
    "name": "zero-to-prod/laravel-declaration",
    "description": "A declarative plugin for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "david_smith",
            "email": "dave0016@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "justinrainbow/json-schema": "^6.13",
        "zero-to-prod/data-model": "^81.20",
        "zero-to-prod/data-model-helper": "^82.1"
    },
    "require-dev": {
        "laravel/mcp": "^0.9",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.5"
    },
    "suggest": {
        "laravel/mcp": "Required by the MCP server that exposes this package's documentation to coding agents."
    },
    "autoload": {
        "psr-4": {
            "ZeroToProd\\LaravelDeclaration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroToProd\\LaravelDeclaration\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/App/Requests/functions.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroToProd\\LaravelDeclaration\\ManifestServiceProvider"
            ]
        }
    },
    "scripts": {
        "test-fresh": "pest",
        "test": "pest --no-tia",
        "coverage": "pest --no-tia --coverage --min=100",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "rector": "rector process",
        "rector-lint": "rector process --dry-run",
        "mcp": "bin/mcp.sh",
        "bc-check": [
            "Composer\\Config::disableProcessTimeout",
            "bin/bc-check.sh"
        ],
        "require-check": [
            "Composer\\Config::disableProcessTimeout",
            "bin/require-check.sh"
        ],
        "check": [
            "@lint",
            "@rector-lint",
            "@analyse",
            "@coverage",
            "@bc-check"
        ],
        "fix": [
            "@rector",
            "@format"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
